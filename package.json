{
  "name": "leadpilot",
  "version": "2.0.0",
  "private": true,
  "description": "React UI and PHP API for multi-message lead replies",
  "scripts": {
    "build": "esbuild frontend/app.jsx --bundle --minify --format=iife --platform=browser --target=es2020 --outfile=public/assets/app.js",
    "build:dev": "esbuild frontend/app.jsx --bundle --sourcemap --format=iife --platform=browser --target=es2020 --outfile=public/assets/app.js",
    "test": "php tests/smoke.php && php tests/workspace.php"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "esbuild": "0.28.0"
  }
}
