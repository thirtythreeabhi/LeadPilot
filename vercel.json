{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/api/(bootstrap|analyze|generate|review|templates)\\.php",
      "dest": "/api/index.php?route=$1.php"
    },
    {
      "src": "/",
      "dest": "/api/index.php"
    }
  ]
}
