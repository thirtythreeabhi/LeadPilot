# Choose openrouter for a free hosted model, or ollama for local inference.
# The key is read only on the PHP server; never commit your real .env.
AI_PROVIDER=openrouter

# Free hosted API (availability and rate limits may change).
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional local Ollama settings (used when AI_PROVIDER=ollama).
# Ollama runs at http://127.0.0.1:11434, never exposed publicly by LeadPilot.
OLLAMA_MODEL=qwen3:4b
